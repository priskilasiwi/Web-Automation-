{
    "name": "selenium-mocha",
    "version": "1.2.0",
    "description": "Test Selenium Webdriver using Mocha",
    "scripts": {
        "test": "mocha test --recursive --timeout 6000 --reporter mochawesome",
        "report": "mocha test --recursive --timeout 10000 --reporter mocha-simple-html-reporter --reporter-options output=hasilreport.html"
    },
    "dependencies": {
        "selenium-webdriver": "^4.17.0"
    },
    "devDependencies": {
        "mocha": "^10.4.0",
        "mochawesome": "^7.1.3",
        "mocha-simple-html-reporter": "^2.0.0"
    }
}