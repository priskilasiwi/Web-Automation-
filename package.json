{
    "name": "selenium-mocha",
    "version": "1.2.0",
    "description": "Test Selenium Webdriver using Mocha",
    "scripts": {
        "test": "mocha test --recursive --timeout 6000 --reporter mochawesome",
        "report": "mocha test/test-sauce.js --recursive --timeout 10000 --reporter mocha-simple-html-reporter --reporter-options output=hasilreport1.html",
        "sesi10": "mocha test/test-sauce2.js --recursive --timeout 10000",
        "sesi11": "mocha test/specs/login.specs.js --recursive --timeout 30000"
    },
    "dependencies": {
        "canvas": "^3.2.3",
        "pixelmatch": "^7.2.0",
        "pngjs": "^7.0.0",
        "selenium-webdriver": "^4.45.0"
    },
    "devDependencies": {
        "chai": "^6.2.2",
        "mocha": "^10.4.0",
        "mocha-simple-html-reporter": "^2.0.0",
        "mochawesome": "^7.1.3"
    }
}
